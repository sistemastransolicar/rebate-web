PORT=3050

# --- SQL Server (mismo servidor para ambas bases) ---
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_USER=rebate_app
SQL_PASSWORD=CAMBIAR
SQL_ENCRYPT=false
SQL_TRUST_CERT=true

# Base del ERP (SOLO LECTURA)
SQL_DB_SYSCOM=dbsyscomTras
# Base propia de reglas (lectura/escritura)
SQL_DB_REBATE=dbRebate

# Rango de datos que maneja la aplicacion
FECHA_MINIMA=2026-01-01

# --- Listado de poseedores afiliados -----------------------------------
# El BI no usa la marca de afiliado del ERP: usa este listado, que cambia
# a diario. La plataforma lo lee del disco y lo relee solo cuando cambia
# la fecha de modificacion del archivo.
RUTA_LISTADO_AFILIADOS=G:\Mi unidad\LISTADO VH AFILIADOS 2025.xlsx
HOJA_LISTADO_AFILIADOS=EDINSO
# Cada cuantos milisegundos se vuelve a mirar la fecha del archivo
REVISAR_LISTADO_MS=15000

# --- Acceso a la seccion de Condiciones ---
# Sin esta clave la seccion queda CERRADA (nunca abierta: un olvido aqui
# no puede volverse una puerta abierta). Ponla larga; es una clave
# compartida, no la de un usuario.
CLAVE_CONDICIONES=

# Firma de la cookie de sesion. Si se deja vacia se genera una al azar en
# cada arranque, y entonces reiniciar el servidor cierra las sesiones
# abiertas. Para evitarlo, pon aqui una cadena larga y aleatoria:
#   powershell -c "[guid]::NewGuid().ToString()+[guid]::NewGuid().ToString()"
SECRETO_SESION=

# Cuanto dura la sesion antes de volver a pedir la clave.
HORAS_SESION=8
